{
  "name": "oomu",
  "version": "0.1.8",
  "private": true,
  "engines": {
    "node": "22.17.0",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "node scripts/prepare-portable-python.mjs && node scripts/prepare-rust-helpers.mjs && node scripts/prepare-artifact-pdf-helper.mjs && node scripts/prepare-vision-helper.mjs && src-tauri/src-swift/build.sh && node scripts/prepare-tauri-external-bins.mjs --verify && tauri dev --runner ../scripts/tauri-dev-runner.mjs --config src-tauri/tauri.development.conf.json",
    "dev:frontend": "next dev --port 3000 --turbo",
    "build": "next build",
    "tauri:prepare": "npm run build && node scripts/prepare-portable-python.mjs --release && node scripts/prepare-tauri-external-bins.mjs && node scripts/prepare-rust-helpers.mjs --release && node scripts/prepare-artifact-pdf-helper.mjs --release && node scripts/prepare-vision-helper.mjs --release && src-tauri/src-swift/build.sh && node scripts/prepare-tauri-external-bins.mjs --verify && node scripts/prepare-portable-python.mjs --release && npm run check:bundle-size",
    "build:prod": "node scripts/release.mjs",
    "release:unsigned": "node scripts/release-unsigned.mjs",
    "release:protected-sign": "node scripts/release-protected-sign.mjs",
    "release:updater-assets": "node scripts/application-update-assets.mjs",
    "release:publish-update": "node scripts/publish-application-update-release.mjs",
    "tauri:dev": "npm run dev",
    "tauri:dev:first-run": "npm run dev -- -- -- --first-run-setup",
    "tauri:build:internal": "node scripts/assert-release-entrypoint.mjs && tauri build",
    "tauri:bundle:internal": "node scripts/assert-release-entrypoint.mjs && tauri bundle",
    "sign:local-app": "node scripts/sign-local-macos-app.mjs",
    "typecheck": "tsc --noEmit",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "check:version": "node scripts/release-version.mjs",
    "check:i18n": "node scripts/check-locale-keys.mjs && node scripts/check-permission-surface-locales.mjs && node scripts/check-jsx-literals.mjs",
    "check:novice-ui": "node scripts/check-novice-first-ui.mjs",
    "check:module-cycles": "node scripts/check-module-cycles.mjs",
    "check:p0-architecture": "node scripts/check-p0-architecture.mjs",
    "check:p1-contracts": "node scripts/check-p1-contract-gate.mjs",
    "check:real-components": "node scripts/check-real-components.mjs",
    "check:repository-hygiene": "node scripts/check-repository-hygiene.mjs",
    "check:unused-exports": "node scripts/check-unused-exports.mjs",
    "check:quality": "npm run lint && npm run check:version && npm run check:source-size && npm run check:real-components && npm run check:p0-architecture && npm run check:p1-contracts && npm run check:novice-ui && npm run check:module-cycles && npm run check:unused-exports && npm run check:repository-hygiene && npm run check:bundle-size",
    "eval:workflow-compose": "tsx scripts/workflow-compose-eval.mts",
    "eval:p0-golden:discovery": "node scripts/p0-golden-tasks.mjs --mode=discovery",
    "verify:local": "node scripts/verification-matrix.mjs --profile=local",
    "verify:qualified": "node scripts/verification-matrix.mjs --profile=qualified",
    "verify:p1-release": "node scripts/p1-release-readiness.mjs",
    "fleet:verify": "npm run verify:qualified",
    "fleet:build:mac": "npm run build:prod",
    "fleet:build:linux": "node scripts/release.mjs --platform linux",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "check:source-size": "scripts/check-rust-file-lines.sh",
    "rust:line-report": "npm run check:source-size",
    "test:frontend": "npm run check:i18n && vitest run",
    "test:release-integrity": "npm run check:version && vitest run scripts/__tests__/release-*.test.mjs scripts/__tests__/release_pipeline_*.test.mjs scripts/__tests__/source-quality-gates.test.mjs",
    "test:frontend:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "next": {
      "sharp": "0.35.0"
    }
  }
}
