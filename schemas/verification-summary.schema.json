{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oomu.local/schemas/verification-summary.schema.json",
  "title": "OOMU Verification Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "status", "counts", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "enum": ["local", "qualified"] },
    "status": { "enum": ["passed", "failed", "environment-blocked", "not-run"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "environment-blocked", "not-run"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "environment-blocked": { "type": "integer", "minimum": 0 },
        "not-run": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "elapsedMs", "exitCode"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "environment-blocked", "not-run"] },
          "elapsedMs": { "type": "integer", "minimum": 0 },
          "exitCode": { "type": ["integer", "null"] },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
