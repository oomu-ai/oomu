<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for production provider inference, web grounding, and
       remote/HTTP MCP transports. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Required for user-approved access to Mail, Notes, Reminders, Messages,
       and other Apple apps controlled through Apple events. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- Required for EventKit Calendar reads and user-approved event writes. -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
</dict>
</plist>
